[Unit]
Description=SmartMirror microphone and on-demand offline speech
BindsTo=smartmirror-hud.service
PartOf=smartmirror-hud.service
After=smartmirror-hud.service

[Service]
Type=simple
WorkingDirectory=%h/presentation-mirror-hud
Environment=PYTHONPATH=src
Environment=PYTHONUNBUFFERED=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
ExecStart=%h/presentation-mirror-hud/.venv/bin/python -m presenter_hud.speech_runner --model models/vosk-model-small-en-us-0.15-pi3 --count-you-know
UMask=0077
NoNewPrivileges=true
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
